{
  "name": "@washy-washy/core",
  "version": "0.0.0",
  "description": "Chart parsing, mixing rules and machine validation for washy-washy — a laundry chart generator.",
  "keywords": [
    "laundry",
    "csv",
    "chart"
  ],
  "homepage": "https://github.com/alrayyes/washy-washy-sdk#readme",
  "bugs": "https://github.com/alrayyes/washy-washy-sdk/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alrayyes/washy-washy-sdk.git"
  },
  "license": "GPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./browser": {
      "types": "./dist/browser.d.mts",
      "default": "./dist/browser.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "bun run lint && bun run lint:md && bun run lint:yaml && bun run lint:package-json && bun run typecheck && bun test",
    "format": "prettier --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:md": "prettier --check \"**/*.md\" && markdownlint-cli2 \"**/*.md\"",
    "lint:package-json": "sort-package-json --check",
    "lint:yaml": "prettier --check \"**/*.{yml,yaml}\"",
    "prepare": "lefthook install",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "csv-parse": "7.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/bun": "1.3.14",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "lefthook": "2.1.10",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6",
    "semantic-release": "25.0.9",
    "sort-package-json": "4.0.0",
    "tsdown": "0.22.14",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "trustedDependencies": [
    "lefthook"
  ]
}
