{
  "name": "@washy-washy/core",
  "version": "2.0.0",
  "description": "Chart parsing, mixing rules and machine validation for washy-washy — a laundry chart generator.",
  "keywords": [
    "laundry",
    "json",
    "chart"
  ],
  "homepage": "https://github.com/alrayyes/washy-washy-core#readme",
  "bugs": "https://github.com/alrayyes/washy-washy-core/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alrayyes/washy-washy-core.git"
  },
  "license": "GPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./browser": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "bun run lint && bun run lint:md && bun run lint:yaml && bun run lint:package-json && bun run lint:prose && bun run lint:schema && bun run lint:types-d && bun run typecheck && bun test",
    "docs": "typedoc",
    "format": "prettier --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:md": "prettier --check \"**/*.md\" && markdownlint-cli2 \"**/*.md\"",
    "lint:package-json": "sort-package-json --check",
    "lint:prose": ".tools/vale --glob='!{styles/**,CHANGELOG.md}' --minAlertLevel=error .",
    "lint:prose:advice": ".tools/vale --glob='!{styles/**,CHANGELOG.md}' .",
    "lint:schema": "bun run schema && git diff --exit-code schema/",
    "lint:types-d": "bun run build && tsd --files \"test-d/**/*.test-d.ts\"",
    "lint:yaml": "prettier --check \"**/*.{yml,yaml}\"",
    "mutation": "stryker run",
    "prepare": "lefthook install",
    "prose:sync": "bun run scripts/install-vale.ts && .tools/vale sync",
    "schema": "ts-json-schema-generator --path src/config.ts --type Config --tsconfig tsconfig.json -o schema/config.schema.json && biome format --write schema/config.schema.json",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "overrides": {
    "katex": "0.18.11",
    "minimatch": "11.0.3",
    "qs": "6.17.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@hughescr/stryker-bun-runner": "1.6.0",
    "@stryker-mutator/core": "10.1.1",
    "@types/bun": "1.4.5",
    "lefthook": "2.2.2",
    "markdownlint-cli2": "0.24.2",
    "prettier": "3.10.1",
    "sort-package-json": "4.1.0",
    "ts-json-schema-generator": "2.10.0",
    "tsd": "0.33.0",
    "tsdown": "0.23.7",
    "typedoc": "0.28.20",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "trustedDependencies": [
    "lefthook"
  ]
}
